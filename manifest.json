{
  "manifest_version": 3,
  "name": "Video Download Master",
  "version": "26.9.12.13",
  "description": "视频嗅探与下载扩展：支持部分网站视频的嗅探与下载（合并与自适应格式）。",
  "permissions": ["downloads", "storage", "activeTab", "offscreen", "scripting", "declarativeNetRequest", "webRequest"],
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://*.ytimg.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Download Master"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["lib/parse.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["media-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
